# Токен от @BotFather. Скопируйте этот файл в .env и подставьте свой токен.
BOT_TOKEN=123456789:AAEcMaeAWPv-OnWWXXXXXXXXXXXXXXXXXXX

# Credentials для Local Bot API server (нужны, чтобы отправлять файлы >50 МБ).
# Получить на https://my.telegram.org/auth → API development tools → создать app.
# api_id — число, api_hash — строка из 32 символов.
TELEGRAM_API_ID=1234567
TELEGRAM_API_HASH=abc123def456abc123def456abc123de
